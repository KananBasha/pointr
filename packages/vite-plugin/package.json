{
  "name": "@pointr/vite-plugin",
  "version": "0.1.0",
  "description": "Vite plugin for Pointr — injects source metadata into JSX elements at build time",
  "keywords": [
    "vite",
    "plugin",
    "dx",
    "ai",
    "mcp",
    "react",
    "source-map"
  ],
  "homepage": "https://github.com/KananBasha/pointr#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/KananBasha/pointr"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "vite": ">=4.0.0"
  },
  "dependencies": {
    "@babel/generator": "^7.24.0",
    "@babel/parser": "^7.24.0",
    "@babel/traverse": "^7.24.0",
    "@babel/types": "^7.24.0",
    "@vue/compiler-sfc": "^3.5.41",
    "magic-string": "^1.2.3",
    "svelte": "^5.56.10"
  },
  "devDependencies": {
    "@types/babel__generator": "^7.6.8",
    "@types/babel__traverse": "^7.20.6",
    "@types/node": "^20.0.0",
    "tsup": "^8.2.0",
    "typescript": "^5.5.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
